{
  "name": "herunterladschneidausgeber",
  "version": "0.1.0",
  "description": "Cross-platform video trimmer. Open a file or paste a link, drag the handles, export.",
  "repository": "github:alancwoo/Herr-Schneider",
  "main": "src/main.js",
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  },
  "optionalDependencies": {
    "ffmpeg-static": "latest",
    "ffprobe-static": "latest"
  },
  "build": {
    "appId": "ca.alanwoo.herunterladschneidausgeber",
    "productName": "Herr Schneider",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "Herr-Schneider-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "type": "distribution"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "Herr-Schneider-${version}-win-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "artifactName": "Herr-Schneider-${version}-linux-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    }
  }
}
